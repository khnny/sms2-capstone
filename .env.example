# sms2_db — HostForge Environment Variables template
# Copy to .env for local use, or paste into HostForge → Environment Variables.
# Never commit a real .env (passwords) to GitHub.

DB_CONNECTION=mysql
DATABASE_URL=mysql://DB_USERNAME:DB_PASSWORD@mariadb-XXXX.internal:3306/hf_db_XXXX
DB_HOST=mariadb-XXXX.internal
DB_PORT=3306
DB_DATABASE=hf_db_XXXX
DB_USERNAME=hf_XXXX
DB_PASSWORD=replace-with-hostforge-password
DB_CHARSET=utf8mb4
