Options -Indexes

RewriteEngine On

# Never rewrite static assets (prevents redirect loops on CSS/JS/images)
RewriteRule ^assets/ - [L]
RewriteRule ^images/ - [L]

RewriteRule ^up$ up.php [END]

# Keep deployment schemas and configuration files server-side only.
RewriteRule ^(?:database|tools)(?:/|$) - [F,L,NC]
RewriteRule ^modules/[^/]+/database(?:/|$) - [F,L,NC]
RewriteRule \.(?:sql|bak|env)$ - [F,L,NC]
RewriteRule ^config/local(?:\..*)?\.php$ - [F,L,NC]

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_php.c>
    php_value post_max_size 16M
    php_value upload_max_filesize 16M
</IfModule>
<IfModule mod_php8.c>
    php_value post_max_size 16M
    php_value upload_max_filesize 16M
</IfModule>
