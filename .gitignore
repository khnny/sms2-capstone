# Machine-specific config (copy from config/local*.example.php)
config/local.php
config/local.infinityfree.php
config/local.hostforge.php
*.env
!.env.example

# One-shot rewrite backups from prefix migration tools
*.preprefix.bak
*.sql.preprefix.bak

# Secrets and generated keys
storage/keys/*
!storage/keys/.gitignore
!storage/keys/.htaccess

# Backups and user uploads
storage/backups/*
!storage/backups/.gitignore
!storage/backups/.htaccess
storage/uploads/*
!storage/uploads/.htaccess

# Accidental nested duplicate copy
sms2_system/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
.vscode/
*.log
.git-sync.lock
.git-sync.log
.git-sync.pending
